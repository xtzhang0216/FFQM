* GENERATED BY CHARMM-GUI (http://www.charmm-gui.org) v3.7 on Apr, 25. 2024. JOBID=1409947857
* read crd files and generate Drude PSF
* NB: Water must be last segment generated do to noangle nodihedral
*

DIMENS CHSIZE 3000000 MAXRES 3000000

! Read topology and parameter files
stream toppar_drude.str

!obtain number of segments and segment names
stream step1_reader_nseg.str
stream step1_reader_seg1.str

open read unit 10 card name step1_reader_seg1.crd
read sequence coor unit 10 RESI  !!!SEGI @segname

generate @segname first none last none setup warn drude dmass 0.4 ! show

!read coordinates
rewind unit 10
read coor card unit 10 append

coor sdrude
!define ninit sele .not. init .and. hydr end

coor shake
!coor print
SHAKE bonh param nofast -
      select  .not. type D*  end -
      select  .not. type D*  end


nbonds atom vatom switch vswitch bycb -
       ctonnb 10.0 ctofnb 12.0 cutnb 16.0 -
       inbfrq -1 imgfrq -1 wmin 1.0 cdie eps 1.0

! first minimize drudes, then entire system
cons harm force 1000000. sele .not. type D* end
mini ABNR nstep 2000 nprint 20

cons harm force 0. MASS sele .not. type D* end
energy


!write full coordinate set
open write unit 10 card name fragb.psf
write psf card unit 10

open write unit 10 card name fragb.pdb
write coor pdb unit 10

open write unit 10 card name fragb.crd
write coor card unit 10

coor stat sele all end

open  write unit 90 card name fragb.str

stop
